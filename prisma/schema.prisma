generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id          String    @id @default(uuid())
  nombre      String
  apellido    String
  email       String    @unique
  telefono    String
  sucursal    String
  plan        String
  fechaInicio DateTime
  estado      String    @default("pending")
  metodoPago  String?
  fechaPago   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
